# ============================================================
# NIPUN.AI — Environment Variables
# Copy to .env and fill in. NEVER commit .env or share real keys.
#
# Legend:  [REQUIRED] app won't work without it
#          [RECOMMENDED] needed for GOOD responses (grounding, images, fallback)
#          [OPTIONAL] enables a specific feature; safe to leave blank (degrades gracefully)
# ============================================================


# ─── APP ─────────────────────────────────────── [REQUIRED] ──
APP_NAME=Nipun.AI
APP_ENV=development                 # development | staging | production
APP_PORT=8000
DEBUG=true                          # set false in production
# REQUIRED — generate your OWN (never reuse a committed value):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_char_random_secret


# ============================================================
#  LLM  — the brain. Everything (queries, explanations, tasks,
#  form-filling, classification) depends on this.
# ============================================================

# ─── PRIMARY (main answers, reasoning, tasks) ── [REQUIRED] ──
LLM_PRIMARY_PROVIDER=google          # google | anthropic | openai | groq | mistral | cohere | ollama
LLM_PRIMARY_MODEL=gemini/gemini-2.5-flash
LLM_PRIMARY_MAX_TOKENS=4096
LLM_PRIMARY_TEMPERATURE=0.3

# ─── FAST (classification, simple/meta answers) ─ [REQUIRED] ──
LLM_FAST_PROVIDER=google
LLM_FAST_MODEL=gemini/gemini-2.5-flash
LLM_FAST_MAX_TOKENS=1024
LLM_FAST_TEMPERATURE=0.1

# ─── FALLBACK (used if primary/fast fail) ─────────────────────
# Set to a FREE Gemini model so failover needs no extra (paid) key — reuses GOOGLE_API_KEY.
LLM_FALLBACK_PROVIDER=google
LLM_FALLBACK_MODEL=gemini/gemini-2.5-flash
LLM_FALLBACK_MAX_TOKENS=2048
LLM_FALLBACK_TEMPERATURE=0.3

# ─── LLM API KEYS ─────────────────────────────────────────────
# [REQUIRED] the key for your PRIMARY+FAST provider. With the defaults above
# (google), GOOGLE_API_KEY is THE critical key — nothing works without it.
# >>> YOU MUST PASTE YOUR FULL KEY HERE <<< (yours was truncated when shared — it should be
# ~39 chars, e.g. AIzaSy...33-more...). Get/verify: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# [OPTIONAL — PAID] Better image generation (DALL·E) if you add it. Not needed: image
# generation already works FREE & keyless via Pollinations.ai, and the LLM fallback is a free
# Gemini model. Add this only if you want DALL·E quality. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# [OPTIONAL] only if you switch a provider above to these.
ANTHROPIC_API_KEY=                   # https://console.anthropic.com/
GROQ_API_KEY=                        # https://console.groq.com/keys
MISTRAL_API_KEY=
COHERE_API_KEY=
# Ollama (fully local LLM, no key): OLLAMA_API_BASE=http://localhost:11434


# ============================================================
#  SEARCH & GROUNDING  — this is what makes answers DEEP and
#  accurate (not shallow Wikipedia) and makes real images work.
#
#  PATTERN (whole app): if you add a key it's used for higher quality; if blank, it FALLS BACK
#  to a free keyless source automatically. So everything works with zero keys — keys just make
#  it better. Add at least ONE search key below for a big jump in answer depth.
# ============================================================

# [RECOMMENDED — biggest quality jump] Tavily: LLM-optimized web search, free tier.
# Get it: https://tavily.com  → sign up → API Keys → copy (starts with tvly-)
TAVILY_API_KEY=

# [RECOMMENDED] SerpAPI: real Google web results + best IMAGE & YouTube discovery.
# Get it: https://serpapi.com  → sign up (free 100/mo) → Your Private API Key
SERPAPI_API_KEY=

# [OPTIONAL] Google Programmable Search (reuses GOOGLE_API_KEY for web + images).
# 1) Google Cloud Console → enable "Custom Search API"
# 2) https://programmablesearchengine.google.com → new engine → "Search the entire web" → copy the Search-Engine ID (cx)
GOOGLE_CSE_ID=

# [OPTIONAL] Brave Search (free tier). https://brave.com/search/api
BRAVE_API_KEY=

WEB_TOOLS_ENABLED=true               # master switch for live web/tool grounding
LIVE_AUGMENT_ENABLED=true
LIVE_HTTP_TIMEOUT=15
LIVE_MAX_RESULTS=5


# ============================================================
#  RESEARCH / BOOKS / NEWS  (all keyless-capable; keys raise limits)
# ============================================================
# [RECOMMENDED for technical topics] stops the research-paper rate-limit (429) errors.
# Get it: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
GOOGLE_BOOKS_API_KEY=                 # [OPTIONAL] richer books (Open Library works keyless)
NEWSAPI_KEY=                          # [OPTIONAL] news works FREE via GDELT; this only upgrades it
PUBMED_API_KEY=                       # [OPTIONAL] medical literature (keyless tier works)
ALPHA_VANTAGE_API_KEY=                # [OPTIONAL] stocks work FREE via Yahoo Finance


# ============================================================
#  INDIA LIVE-DATA TOOLS
#  Pattern everywhere: use the key if you add one, else fall back to a FREE source.
# ============================================================
# Weather → already FREE & keyless (Open-Meteo). No key needed; IMD_API_KEY is legacy/unused.
IMD_API_KEY=
# Mandi (market) prices → data.gov.in (FREE, just register). Without it, farming gives MSP
# guidance instead of live prices. Get it: https://data.gov.in (free API key in your profile).
DATA_GOV_IN_API_KEY=
AGMARKNET_API_KEY=                    # alternative mandi key (optional)
# Case law → IndianKanoon API is PAID; leave blank and it falls back to free web search.
INDIANKANOON_API_KEY=
# Indic translation/speech → optional (the LLM already handles Indian languages). Free but
# needs Bhashini/ULCA registration; leave blank to skip.
AI4BHARAT_API_KEY=
AI4BHARAT_API_BASE=https://api.ai4bharat.org


# ============================================================
#  EMBEDDINGS & RERANKER  (local models — run on your GPU)
# ============================================================
EMBEDDING_PROVIDER=local              # local (BGE-M3, best for Indic) | openai | cohere
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_USE_FP16=true
# Where models are cached. Keep as-is so it reuses the BGE-M3 you already downloaded
# (resolves to backend/backend/models when you run from the backend dir). Change only if you
# move the cache — a wrong path triggers a ~2 GB re-download.
EMBEDDING_MODEL_CACHE=backend/models
EMBEDDING_DEVICE=auto                 # auto (GPU if available) | cuda | cpu

RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=5
RERANKER_CANDIDATES=30
# On a small GPU (≈4 GB, e.g. GTX 1650) keep the reranker on CPU so it doesn't
# OOM alongside the embedder. On an 8 GB+ GPU you can set this to "auto".
RERANKER_DEVICE=cpu


# ============================================================
#  DATABASES / INFRA   (run via: docker compose up -d)
# ============================================================
# ─── POSTGRES ────────────────────────────────── [REQUIRED] ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nipun_ai
POSTGRES_USER=nipun
POSTGRES_PASSWORD=nipun_123          # matches your existing Postgres container
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ─── REDIS ───────────────────────────────────── [REQUIRED] ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ─── QDRANT (vector DB) ──────────────────────── [REQUIRED] ──
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_QUANTIZATION_ENABLED=true
QDRANT_QUANTIZATION_ALWAYS_RAM=true
QDRANT_RESCORE_OVERSAMPLING=2.0

# ─── ELASTICSEARCH (exact-match search) ──────── [OPTIONAL] ──
# Used for section numbers / case IDs / scheme names. App still works without it
# (falls back to vector search). Must match your docker-compose ES credentials.
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=nipun_ELASTICSEARCH
ELASTICSEARCH_PASSWORD=nipun_ELASTICSEARCH_123

# ─── NEO4J (GraphRAG, multi-hop) ─────────────── [OPTIONAL] ──
GRAPH_ENABLED=false                   # set true only once Neo4j is running
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
GRAPH_ONLY_FOR_MULTIHOP=true


# ─── CELERY (background jobs: book ingestion, etc.) ── [REQUIRED] ──
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2


# ============================================================
#  AUTH  — [REQUIRED]
# ============================================================
# REQUIRED — generate your OWN (see SECRET_KEY above). Do NOT reuse a committed value.
JWT_SECRET_KEY=CHANGE_ME_generate_a_64_char_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# ─── BOOTSTRAP ADMIN (first-run seed account) ─────────────────────────────────
# Created on first start if no admin exists. Dev defaults below are PUBLICLY KNOWN — in
# production you MUST set a strong password (or BOOTSTRAP_ADMIN_ENABLED=false). Startup
# refuses to seed the default password when APP_ENV=production.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_NAME=Harsh Shukla
BOOTSTRAP_ADMIN_EMAIL=admin@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=admin2402

# ─── CORS (production only) ────────────────────────────────────────────────────
# In development, any localhost/127.0.0.1/LAN origin is allowed automatically. For
# production, list the exact frontend origins (JSON array), e.g.
#   CORS_ALLOW_ORIGINS=["https://app.nipun.ai"]
CORS_ALLOW_ORIGINS=[]

# Per-call LLM timeout (seconds) — bounds a hung provider. Well above a normal call.
LLM_REQUEST_TIMEOUT=60


# ============================================================
#  TASK EXECUTION  (form-filling / bookings / ITR / job-apply)
# ============================================================
# Previews + form-filling + hand-off work with just the LLM key (nothing is
# ever really submitted). Leave EXECUTION_ENABLED=false unless you register a
# real action handler — the app fills everything and hands login/OTP/submit to the user.
EXECUTION_ENABLED=false
TASK_PREVIEW_ENABLED=true
EXECUTION_CONFIRM_TTL=600

# ─── Gmail / Google Drive (act on user's own data) ── [OPTIONAL] ──
# Requires an OAuth consent flow (never raw credentials). Off until wired.
GOOGLE_APPS_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Communication / Payments (future) ───────── [OPTIONAL] ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# ============================================================
#  LANGUAGES / RATE LIMITS / SAFETY
# ============================================================
SUPPORTED_LANGUAGES=["en","hi","pa","ta","te","mr","gu"]
DEFAULT_LANGUAGE=hi

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LLM_PER_MINUTE=20
RATE_LIMIT_ACTION_PER_MINUTE=5

SAFETY_PRESCREEN_ENABLED=true
SAFETY_PRESCREEN_USE_LLM=true
CONFIDENCE_ABSTAIN_THRESHOLD=0.5
NALSA_LEGAL_AID_HELPLINE=15100        # verified baseline; fill others only with verified numbers
CRISIS_HELPLINE_MENTAL_HEALTH=        # e.g. Tele-MANAS 14416 (verify before enabling)
CRISIS_HELPLINE_EMERGENCY=            # e.g. 112 / 108 (verify before enabling)


# ============================================================
#  FEATURE FLAGS  (sensible defaults — tune for speed vs depth)
# ============================================================
CLARIFY_ENABLED=true                  # ask for missing details when needed
MEMORY_ENABLED=true                   # remember facts about the user across chats
PROFILE_MEMORY_ENABLED=true           # learn profile facts from conversation
CITATION_AGENT_ENABLED=true           # find a source for each claim (quality; costs 1 LLM call)
VERIFY_CLAIMS_USE_LLM=true            # reliability scoring (costs 1 LLM call)
RAG_MAX_LOOPS=3                       # lower to 1 for faster answers
BOOKS_INGEST_ENABLED=true


# ============================================================
#  OBSERVABILITY
# ============================================================
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
PROMETHEUS_PORT=9090
LOG_FLOW_ENABLED=true                 # write full request flow to logs/chat.log (turn off in prod)
METERING_ENABLED=true


# ─── FRONTEND ─────────────────────────────────────────────────
# NOTE: these do NOT belong in this backend .env. The frontend is Vite/React and reads only
# VITE_* vars. For LOCAL dev you need nothing (it defaults to http://localhost:8000 and derives
# the WebSocket URL from it). To point the frontend at a deployed backend, create
# frontend/.env with:
#     VITE_API_BASE_URL=https://your-backend-host
# (The old NEXT_PUBLIC_* names were Next.js and are ignored — removed.)
